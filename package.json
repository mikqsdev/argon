{
  "name": "argon-agent",
  "version": "0.3.0",
  "description": "Argon (Ar, 18) — open-source AI agent: Rust CLI, Tauri desktop app, multi-provider core with MCP, skills and usage limits",
  "main": "dist/core/index.js",
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . --watch",
    "start": "node dist/cli/main.js",
    "gui": "node dist/cli/main.js gui --web",
    "test": "node --test test/*.test.mjs",
    "cli": "npm run build && cd rust && cargo run -p argon-cli --",
    "desktop": "npm run build && node scripts/tauri.mjs dev",
    "stage": "node scripts/stage-core.mjs",
    "dist": "npm run build && node scripts/stage-core.mjs && node scripts/tauri.mjs build"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chalk": "^5.6.2",
    "marked": "^15.0.12",
    "material-symbols": "^0.49.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "typescript": "5.9"
  },
  "bin": {
    "argon-core": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "gui",
    "docs/logo.svg",
    "README.md",
    "LICENSE",
    "CLAUDE.md"
  ],
  "author": "mikqsdev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikqsdev/argon.git"
  },
  "homepage": "https://github.com/mikqsdev/argon#readme",
  "bugs": {
    "url": "https://github.com/mikqsdev/argon/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "mcp",
    "llm",
    "claude",
    "openai",
    "openrouter",
    "rust",
    "tauri",
    "material-design"
  ]
}
