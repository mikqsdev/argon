{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Argon",
  "mainBinaryName": "Argon",
  "version": "1.0.0",
  "identifier": "dev.mikqs.argon",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "mikqsdev",
    "copyright": "MIT License",
    "shortDescription": "Open-source AI agent",
    "longDescription": "Argon: an open-source AI agent with a full-screen terminal CLI and a desktop app.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "stage/core/": "core/",
      "stage/bin/": "bin/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh",
        "languages": ["English", "Italian"],
        "displayLanguageSelector": false
      }
    }
  }
}
